# ETL
OPENALEX_API_KEY=your_openalex_api_key
ODS_SETTINGS_PATH=config/institution.toml

# Publish webhook
APPS_SCRIPT_WEBAPP_URL=your_apps_script_web_app_url
APPS_SCRIPT_SHARED_SECRET=your_shared_secret
APPS_SCRIPT_MAX_FILE_BYTES=8000000

# Note
# ROOT_FOLDER_ID, SPREADSHEET_ID, and WEBHOOK_SHARED_SECRET belong to
# Google Apps Script project properties, not to the Python .env file.
